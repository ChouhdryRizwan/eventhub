# Strapi API (no trailing slash)
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
NEXT_PUBLIC_STRAPI_API_URL=http://localhost:1337/api

# Public URL of this site (used for sitemap, Open Graph and structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NextAuth / Auth.js (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Strapi full-access API token, SERVER ONLY (never prefix with NEXT_PUBLIC_).
# Create it in Strapi admin: Settings > API Tokens > Full access.
STRAPI_API_TOKEN=

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# AI event assistant (Google Gemini). SERVER ONLY. Free key: https://aistudio.google.com/apikey
# Without it the Ask AI button shows a "not switched on" message. Optional: GEMINI_MODEL (default gemini-3.5-flash-lite: the big flash models were overloaded on the free tier)
# and GEMINI_FALLBACK_MODELS (default gemini-flash-lite-latest,gemini-3-flash-preview), used when the main model is slow or overloaded.
GEMINI_API_KEY=
