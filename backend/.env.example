# ---- Server ----
HOST=0.0.0.0
PORT=1337
# Production only: public URL of this API and trust the proxy in front of it (Render)
# PUBLIC_URL=https://eventhub-api.onrender.com
# IS_PROXIED=true

# ---- Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") ----
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# ---- Database: NeonDB (use the pooled connection string) ----
DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# ---- Browser origins allowed to call the API (comma separated; add the Vercel URL) ----
CORS_ORIGINS=http://localhost:3000

# ---- Cloudinary (media uploads) ----
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# ---- First boot only ----
# Seeds the 6 categories and 16 sample events once (does nothing if categories already exist)
SEED_DATA=true
# Creates an Administrator account for the Next.js /admin panel. Use a strong password and change it after first login.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ---- Email: Gmail SMTP (needs 2-Step Verification + an App password) ----
# Leave SMTP_PASS empty to turn emails off (sign-up then needs no email confirmation).
SMTP_USER=your.address@gmail.com
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# URL of the Next.js site (links in emails and where the confirmation link sends people)
FRONTEND_URL=http://localhost:3000
