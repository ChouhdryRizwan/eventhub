{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "description": {
      "type": "text",
      "required": true
    },
    "short_desc": {
      "type": "string",
      "maxLength": 200
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "events"
    },
    "venue_address": {
      "type": "string",
      "required": true
    },
    "latitude": {
      "type": "float"
    },
    "longitude": {
      "type": "float"
    },
    "start_datetime": {
      "type": "datetime",
      "required": true
    },
    "end_datetime": {
      "type": "datetime"
    },
    "ticket_price": {
      "type": "decimal",
      "default": 0
    },
    "is_free": {
      "type": "boolean",
      "default": true
    },
    "organizer_name": {
      "type": "string"
    },
    "organizer_email": {
      "type": "email"
    },
    "organizer_phone": {
      "type": "string"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "published",
        "rejected"
      ],
      "default": "pending",
      "required": true
    },
    "submitted_by": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "avg_rating": {
      "type": "decimal",
      "default": 0
    },
    "rsvp_count": {
      "type": "integer",
      "default": 0
    }
  }
}
